    "express": "5.1.0",
    "ajv": "8.17.1",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "22.15.30"
  }
}




