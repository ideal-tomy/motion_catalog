{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI PROMO STUDIO MVP Project",
  "type": "object",
  "required": [
    "schemaVersion",
    "projectId",
    "revision",
    "title",
    "video",
    "theme",
    "scenes",
    "assets",
    "audioTracks",
    "locks"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{2,64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "brief": {
      "type": "string",
      "maxLength": 4000
    },
    "video": {
      "type": "object",
      "required": [
        "fps",
        "width",
        "height",
        "targetDurationFrames",
        "durationPolicy"
      ],
      "properties": {
        "fps": {
          "enum": [
            24,
            25,
            30,
            60
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 320,
          "maximum": 3840
        },
        "height": {
          "type": "integer",
          "minimum": 240,
          "maximum": 3840
        },
        "targetDurationFrames": {
          "type": "integer",
          "minimum": 1
        },
        "durationPolicy": {
          "enum": [
            "ripple",
            "fixed"
          ]
        }
      },
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "required": [
        "requestedColors",
        "palette"
      ],
      "properties": {
        "requestedColors": {
          "type": "object",
          "required": [
            "primary",
            "secondary"
          ],
          "properties": {
            "primary": {
              "$ref": "#/$defs/hex"
            },
            "secondary": {
              "anyOf": [
                {
                  "$ref": "#/$defs/hex"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "palette": {
          "type": "object",
          "required": [
            "background",
            "surface",
            "text",
            "primary",
            "accent",
            "mutedText"
          ],
          "properties": {
            "background": {
              "$ref": "#/$defs/hex"
            },
            "surface": {
              "$ref": "#/$defs/hex"
            },
            "text": {
              "$ref": "#/$defs/hex"
            },
            "primary": {
              "$ref": "#/$defs/hex"
            },
            "accent": {
              "$ref": "#/$defs/hex"
            },
            "mutedText": {
              "$ref": "#/$defs/hex"
            }
          },
          "additionalProperties": false
        },
        "suggestedUsage": {
          "type": "object",
          "properties": {
            "basePct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "primaryPct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "accentPct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "note": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assetId",
          "kind",
          "path"
        ],
        "properties": {
          "assetId": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "enum": [
              "image",
              "video",
              "audio",
              "logo"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string"
          },
          "verifiedForUse": {
            "type": "boolean"
          },
          "sourceUrl": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "audioTracks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "trackId",
          "assetId",
          "startFrame",
          "durationFrames"
        ],
        "properties": {
          "trackId": {
            "$ref": "#/$defs/id"
          },
          "assetId": {
            "$ref": "#/$defs/id"
          },
          "startFrame": {
            "type": "integer",
            "minimum": 0
          },
          "durationFrames": {
            "type": "integer",
            "minimum": 1
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "fadeInFrames": {
            "type": "integer",
            "minimum": 0
          },
          "fadeOutFrames": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "locks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scope",
          "targetId",
          "field"
        ],
        "properties": {
          "scope": {
            "enum": [
              "project",
              "scene",
              "layer"
            ]
          },
          "targetId": {
            "type": "string"
          },
          "field": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "meta": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{2,80}$"
    },
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "motion": {
      "type": "object",
      "required": [
        "motionId",
        "startOffsetFrames",
        "durationFrames",
        "params"
      ],
      "properties": {
        "motionId": {
          "type": "string",
          "pattern": "^M-[0-9]{3}$"
        },
        "startOffsetFrames": {
          "type": "integer",
          "minimum": 0
        },
        "durationFrames": {
          "type": "integer",
          "minimum": 1
        },
        "params": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "layer": {
      "type": "object",
      "required": [
        "layerId",
        "kind",
        "zIndex",
        "inFrame",
        "durationFrames",
        "opacity",
        "visible",
        "locked",
        "transform",
        "motionStack"
      ],
      "properties": {
        "layerId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "text",
            "image",
            "video",
            "shape",
            "overlay"
          ]
        },
        "zIndex": {
          "type": "integer"
        },
        "inFrame": {
          "type": "integer",
          "minimum": 0
        },
        "durationFrames": {
          "type": "integer",
          "minimum": 1
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "visible": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        },
        "assetId": {
          "$ref": "#/$defs/id"
        },
        "transform": {
          "type": "object",
          "required": [
            "x",
            "y",
            "width",
            "height",
            "rotateDeg"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": -2,
              "maximum": 2
            },
            "y": {
              "type": "number",
              "minimum": -2,
              "maximum": 2
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 4
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 4
            },
            "rotateDeg": {
              "type": "number",
              "minimum": -3600,
              "maximum": 3600
            }
          },
          "additionalProperties": false
        },
        "style": {
          "type": "object"
        },
        "motionStack": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/motion"
          }
        }
      },
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "required": [
        "sceneId",
        "role",
        "durationFrames",
        "layout",
        "paceKeyframes",
        "colorOverrides",
        "unplacedLayerIds",
        "layers"
      ],
      "properties": {
        "sceneId": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": [
            "intro",
            "problem",
            "feature",
            "explanation",
            "result",
            "cta",
            "transition",
            "other"
          ]
        },
        "durationFrames": {
          "type": "integer",
          "minimum": 1
        },
        "layout": {
          "type": "object",
          "required": [
            "type",
            "direction",
            "splitRatio",
            "cells"
          ],
          "properties": {
            "type": {
              "enum": [
                "single",
                "split2",
                "grid4",
                "free"
              ]
            },
            "direction": {
              "enum": [
                "horizontal",
                "vertical"
              ]
            },
            "splitRatio": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 0.8
            },
            "cells": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            }
          },
          "additionalProperties": false
        },
        "paceKeyframes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "position",
              "intensity"
            ],
            "properties": {
              "position": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "intensity": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "additionalProperties": false
          }
        },
        "colorOverrides": {
          "type": "object"
        },
        "unplacedLayerIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layer"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
